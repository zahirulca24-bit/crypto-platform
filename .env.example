# Environment Configuration (Safe Defaults for Local Development)

# PostgreSQL & TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crypto_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# API
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# JWT Configuration
JWT_SECRET_KEY=dev_secret_key_change_in_production_987654321
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Web Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

# Demo Exchange Credentials
DEMO_EXCHANGE=binance
DEMO_API_KEY=example_demo_api_key
DEMO_API_SECRET=example_demo_api_secret
DEMO_API_PASSWORD=

# Phase 4 AI Research (Google AI Studio / Gemini) - optional, research-only
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
GOOGLE_AI_TEMPERATURE=0.2
GOOGLE_AI_MAX_OUTPUT_TOKENS=2048
GOOGLE_AI_TIMEOUT_SECONDS=30
AI_RESEARCH_MAX_PROPOSALS_PER_RUN=5
AI_REVIEW_MIN_EVIDENCE_SCORE=0.35
AI_REVIEW_MIN_TESTABILITY_SCORE=0.45
AI_REVIEW_MIN_DATA_QUALITY_SCORE=0.35
AI_REVIEW_MIN_OVERALL_SCORE=0.50
AI_BLUEPRINT_MIN_READINESS_SCORE=0.65
AI_BLUEPRINT_MAX_PARAMETER_COMBINATIONS=500
AI_BLUEPRINT_MAX_CONDITIONS=20
# Phase 4 deterministic blueprint validation/backtesting (research simulation only)
AI_BACKTEST_FEE_BPS=10
AI_BACKTEST_SLIPPAGE_BPS=5
AI_BACKTEST_INTRABAR_CONFLICT_POLICY=stop_first
AI_BACKTEST_FIXED_NOTIONAL=1000
AI_VALIDATION_MIN_TRADES=10
AI_VALIDATION_MIN_EXPECTANCY=0
AI_VALIDATION_MIN_PROFIT_FACTOR=1.05
AI_VALIDATION_MAX_DRAWDOWN=20
AI_VALIDATION_MIN_STABILITY=0.50
AI_VALIDATION_MIN_DATA_QUALITY=0.60
AI_VALIDATION_MAX_OVERFIT_RISK=0.65
AI_VALIDATION_MAX_EXECUTION_COST_DRAG=0.60

# Phase 4 strategy evolution research (P4-05)
AI_EVOLUTION_MAX_VARIANTS_PER_GENERATION=10
AI_EVOLUTION_MAX_CHANGED_FIELDS=3
AI_EVOLUTION_MAX_GENERATIONS_PER_REQUEST=1
AI_EVOLUTION_MIN_CHALLENGER_IMPROVEMENT=0.03

# P4-06 research-only strategy matching / simulated portfolio
AI_MATCH_MIN_REGIME_TRADES=10
AI_PORTFOLIO_MAX_COMPONENTS=5
AI_PORTFOLIO_MAX_COMPONENT_WEIGHT=0.40
AI_PORTFOLIO_MAX_PAIRWISE_CORRELATION=0.85
AI_PORTFOLIO_MIN_READINESS_SCORE=0.60

# Phase 4 P4-07 shadow research + controlled candidate handoff
AI_SHADOW_MIN_TRADES=10
AI_SHADOW_MIN_EXPECTANCY=0
AI_SHADOW_MAX_DRAWDOWN=1000
AI_SHADOW_MAX_DRIFT=0.50
AI_SHADOW_MIN_DATA_QUALITY=0.60
AI_SHADOW_MIN_READINESS_SCORE=0.60
AI_SHADOW_MAX_CANDLES_PER_PROCESS=250
AI_HANDOFF_REQUIRE_SHADOW=false

# Phase 4 P4-08 adaptive research monitoring (research-only)
AI_MONITOR_AUTO_QUEUE_RESEARCH=false
AI_MONITOR_DEFAULT_COOLDOWN_SECONDS=21600
AI_MONITOR_MIN_SAMPLE_SIZE=20
AI_MONITOR_MAX_POLICIES_PER_CYCLE=50
AI_MONITOR_MAX_TRIGGERS_PER_CYCLE=20
AI_MONITOR_MAX_JOBS_PER_CYCLE=10
AI_MONITOR_POLL_SECONDS=60
AI_MONITOR_MAX_JOB_RETRIES=1

# P4-09 Demo Strategy Manifest / Runtime Governance (research/runtime handoff only)
AI_DEMO_MANIFEST_MIN_COMPATIBILITY_SCORE=0.80
AI_DEMO_RELEASE_MIN_READINESS_SCORE=0.75
AI_DEMO_RELEASE_BLOCK_SEVERE_TRIGGERS=true
