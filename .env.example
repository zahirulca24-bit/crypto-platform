# Environment Configuration (Safe Defaults for Local Development)

# PostgreSQL & TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crypto_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# API
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# JWT Configuration
JWT_SECRET_KEY=dev_secret_key_change_in_production_987654321
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Web Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

# Demo Exchange Credentials
DEMO_EXCHANGE=binance
DEMO_API_KEY=example_demo_api_key
DEMO_API_SECRET=example_demo_api_secret
DEMO_API_PASSWORD=
