# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=crypto_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (Transient/Coordination)
REDIS_HOST=redis
REDIS_PORT=6379

# API Config
API_PORT=8000
ENVIRONMENT=development

# Security
JWT_SECRET_KEY=your_secure_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CREDENTIAL_ENCRYPTION_KEY=
MAX_REQUEST_BODY_BYTES=1048576
PUBLIC_REGISTRATION_ENABLED=false

# Worker Config
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Web Config
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

# Demo Exchange (Binance)
DEMO_EXCHANGE=binance
DEMO_API_KEY=
DEMO_API_SECRET=
DEMO_API_PASSWORD=

# Trading & Runtime Flags
RUNTIME_MODE=development
TRADING_MODE=disabled
ALLOW_LIVE_TRADING=false
DEBUG=false
RELOAD=false
DEVELOPMENT_FEATURES=false
SQL_ECHO=false

# Safety Limits
LIVE_EXCHANGE_ID=
EXCHANGE_TIMEOUT_MS=10000
EXCHANGE_MAX_SAFE_RETRIES=2
EXCHANGE_RETRY_DELAY_SECONDS=0.25

SAFETY_CONNECTIVITY_FAILURE_THRESHOLD=3
SAFETY_ORDER_ERROR_THRESHOLD=5
SAFETY_RECONCILIATION_FAILURE_THRESHOLD=3
SAFETY_MARKET_DATA_MAX_AGE_SECONDS=30
SAFETY_MAX_CLOCK_DRIFT_SECONDS=5

WORKER_LEASE_TTL_SECONDS=30
ALERT_MIN_INTERVAL_SECONDS=300
